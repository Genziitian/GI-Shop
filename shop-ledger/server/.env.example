# Server Configuration
PORT=3001
JWT_SECRET=your-production-jwt-secret-key-change-me

# Database Configuration
# Default is database.sqlite in the server directory
DATABASE_PATH=./database.sqlite

# Optional Super Administrator Bootstrap
# If configured and no SuperManager account exists in the database, the server will auto-create this account on initial startup.
SUPERADMIN_NAME=Platform Administrator
SUPERADMIN_EMAIL=admin@gishop.local
SUPERADMIN_PHONE=9999999999
SUPERADMIN_PASSWORD=change_this_admin_password_123
SUPERADMIN_PIN=1234
SUPERADMIN_CITY=Delhi
